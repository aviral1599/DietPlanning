# Postgres connection string (e.g. from Neon — use the POOLED connection string).
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign auth session tokens. Use a long random string (32+ chars).
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional: a global fallback Anthropic API key for AI analysis.
# Coaches can also set their own key in Settings.
# ANTHROPIC_API_KEY="sk-ant-..."
